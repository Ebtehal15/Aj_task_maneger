  <% if (typeof selectedUserIds !== 'undefined' && selectedUserIds.length && typeof users !== 'undefined' && users.length) { %>
  <p class="text-muted mb-2"><%= t('selectUserForReport') %></p>

  <% 
    const baseParams = [];
    baseParams.push('tab=users');
    if (typeof selectedUserIdsParam !== 'undefined' && selectedUserIdsParam) {
      baseParams.push('userIds=' + encodeURIComponent(selectedUserIdsParam));
    }
    if (filters && filters.userId) {
      baseParams.push('userId=' + encodeURIComponent(String(filters.userId)));
    }
    const baseQS = baseParams.join('&');
    const currentStatus = (filters && filters.status) ? String(filters.status) : '';
    const isStatusDone = currentStatus === 'done';
    const isStatusInProgress = currentStatus === 'in_progress';
    const isStatusPending = currentStatus === 'pending';
    const isUrgent = !!(filters && (filters.urgent === 'true' || filters.urgent === true));
    const statusBaseQS = baseQS + (isUrgent ? '&urgent=true' : '');
    const urgentBaseQS = baseQS + (currentStatus ? '&status=' + encodeURIComponent(currentStatus) : '');
  %>

  <div class="btn-group btn-group-sm mb-3" role="group" aria-label="User status filters">
    <a
      href="/admin/reports?<%= statusBaseQS %><%= isStatusDone ? '' : (statusBaseQS ? '&' : '') + 'status=done' %>"
      class="btn <%= isStatusDone ? 'btn-success' : 'btn-outline-success' %>"
    >
      <%= t('completedTasks') %>
    </a>
    <a
      href="/admin/reports?<%= statusBaseQS %><%= isStatusInProgress ? '' : (statusBaseQS ? '&' : '') + 'status=in_progress' %>"
      class="btn <%= isStatusInProgress ? 'btn-warning text-dark' : 'btn-outline-warning' %>"
    >
      <%= t('inProgressTasks') %>
    </a>
    <a
      href="/admin/reports?<%= statusBaseQS %><%= isStatusPending ? '' : (statusBaseQS ? '&' : '') + 'status=pending' %>"
      class="btn <%= isStatusPending ? 'btn-tm-pending' : 'btn-outline-tm-pending' %>"
    >
      <%= t('pendingTasks') %>
    </a>
    <a
      href="/admin/reports?<%= urgentBaseQS %><%= isUrgent ? '' : (urgentBaseQS ? '&' : '') + 'urgent=true' %>"
      class="btn <%= isUrgent ? 'btn-danger' : 'btn-outline-danger' %>"
    >
      <%= t('urgentTasks') %>
    </a>
  </div>

  <div class="row g-3 mb-4">
    <% users.forEach(u => { %>
      <% if (selectedUserIds.indexOf(Number(u.id)) !== -1) { %>
      <div class="col-6 col-md-4 col-lg-3">
        <% 
          const isActiveUser = (filters && Number(filters.userId) === Number(u.id));
          let userCardQs = 'tab=users';
          if (typeof selectedUserIdsParam !== 'undefined' && selectedUserIdsParam) userCardQs += '&userIds=' + encodeURIComponent(selectedUserIdsParam);
          if (!isActiveUser) { userCardQs += '&userId=' + encodeURIComponent(u.id) + '&filterTypes=user'; }
          if (filters && filters.status) userCardQs += '&status=' + encodeURIComponent(String(filters.status));
          if (filters && (filters.urgent === 'true' || filters.urgent === true)) userCardQs += '&urgent=true';
        %>
        <a
          href="/admin/reports?<%= userCardQs %>"
          class="text-decoration-none text-reset d-block"
        >
          <div class="card border-0 h-100 user-pill-card <%= isActiveUser ? 'user-pill-card-active' : '' %>">
            <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
              <div class="user-pill-avatar">
                <% if (u.avatar) { %>
                  <img src="/<%= u.avatar %>" alt="<%= u.username %>" class="user-pill-avatar-image" />
                <% } else { %>
                  <span><%= (u.username || '?').charAt(0).toUpperCase() %></span>
                <% } %>
              </div>
              <span class="fw-semibold text-dark" style="font-size: 0.9rem;"><%= u.username %></span>
            </div>
          </div>
        </a>
      </div>
      <% } %>
    <% }) %>
  </div>
  <% } else { %>
  <p class="text-muted mb-0"><%= t('selectUserForReport') %></p>
  <% } %>
</div>
