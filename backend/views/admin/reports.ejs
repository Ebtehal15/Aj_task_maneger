          <span class="badge bg-primary ms-1"><%= selectedUserIds.length %></span>
        <% } %>
      </button>
      <div class="dropdown-menu p-3 shadow-sm rounded-3" style="min-width: 260px;" aria-labelledby="userSelectDropdownBtn">
        <% if (typeof users !== 'undefined' && users.length) { %>
          <div class="row g-1">
            <% users.forEach(u => { %>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input user-id-checkbox" type="checkbox" name="userIds" value="<%= u.id %>" id="user-cb-<%= u.id %>" <%= (typeof selectedUserIds !== 'undefined' && selectedUserIds.indexOf(Number(u.id)) !== -1) ? 'checked' : '' %>>
