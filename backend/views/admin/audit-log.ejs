<%
  function auditLogQs(pageNum) {
    var p = new URLSearchParams();
    if (filters.action) p.set('action', filters.action);
    if (filters.username) p.set('username', filters.username);
    if (filters.date_from) p.set('date_from', filters.date_from);
    if (filters.date_to) p.set('date_to', filters.date_to);
    if (pageNum) p.set('page', String(pageNum));
    var s = p.toString();
    return s ? '?' + s : '';
  }
%>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h4 mb-0"><%= t('auditLogPageTitle') %></h1>
  <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">← <%= t('back') %></a>
</div>

<form method="get" action="/admin/audit-log" class="card shadow-sm mb-3">
  <div class="card-body p-3">
    <div class="row g-2 align-items-end">
      <div class="col-12 col-md-3">
        <label class="form-label small mb-0"><%= t('auditLogFilterAction') %></label>
        <input type="text" name="action" class="form-control form-control-sm" value="<%= filters.action %>" />
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label small mb-0"><%= t('auditLogFilterUsername') %></label>
        <input type="text" name="username" class="form-control form-control-sm" value="<%= filters.username %>" />
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small mb-0"><%= t('auditLogDateFrom') %></label>
        <input type="date" name="date_from" class="form-control form-control-sm" value="<%= filters.date_from %>" />
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small mb-0"><%= t('auditLogDateTo') %></label>
        <input type="date" name="date_to" class="form-control form-control-sm" value="<%= filters.date_to %>" />
      </div>
      <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100"><%= t('auditLogApplyFilters') %></button>
      </div>
    </div>
  </div>
</form>

<p class="small text-muted mb-2">
  <%= t('auditLogTotalRows') %>: <strong><%= total %></strong>
  <% if (typeof page !== 'undefined' && typeof totalPages !== 'undefined') { %>
    — <%= page %> / <%= totalPages %>
  <% } %>
</p>

<% if (!rows || rows.length === 0) { %>
  <div class="alert alert-secondary"><%= t('auditLogNoEntries') %></div>
<% } else { %>
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-sm table-striped table-hover mb-0 align-middle" style="font-size: 0.85rem;">
      <thead class="table-light">
        <tr>
          <th scope="col"><%= t('auditLogColTime') %></th>
          <th scope="col"><%= t('auditLogColPerformedBy') %></th>
          <th scope="col"><%= t('auditLogColAction') %></th>
          <th scope="col"><%= t('auditLogColEntity') %></th>
          <th scope="col"><%= t('auditLogColDetails') %></th>
          <th scope="col"><%= t('auditLogColIp') %></th>
          <% if (typeof canDeleteAuditLog !== 'undefined' && canDeleteAuditLog) { %>
          <th scope="col" class="text-end"><%= t('delete') %></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) {
          var ts = row.created_at;
          var timeStr = '';
          if (ts) {
            try {
              var d = new Date(ts);
              timeStr = d.toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' });
            } catch (e) { timeStr = String(ts); }
          }
          var det = row.details;
          var detStr = '';
          if (det != null) {
            detStr = typeof det === 'object' ? JSON.stringify(det) : String(det);
          }
        %>
        <tr>
          <td class="text-nowrap"><%= timeStr %></td>
          <td><strong><%= (row.u_username || row.username_snapshot) || '—' %></strong></td>
          <td><code><%= row.action %></code></td>
          <td class="small">
            <% if (row.entity_type) { %>
              <%= row.entity_type %><% if (row.entity_id != null) { %> <span class="text-muted">#<%= row.entity_id %></span><% } %>
            <% } else { %>
              —
            <% } %>
          </td>
          <td class="small text-break" style="max-width: 280px;"><%= detStr || '—' %></td>
          <td class="small text-nowrap"><%= row.ip_address || '—' %></td>
          <% if (typeof canDeleteAuditLog !== 'undefined' && canDeleteAuditLog) { %>
          <td class="text-end text-nowrap">
            <form method="post" action="/admin/audit-log/<%= row.id %>/delete" class="d-inline js-audit-delete-form" id="audit-delete-form-<%= row.id %>">
              <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 js-audit-delete-open" title="<%= t('auditLogDelete') %>" data-form-id="audit-delete-form-<%= row.id %>" aria-haspopup="dialog">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <% if (typeof page !== 'undefined' && typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <% if (page > 1) { %>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/audit-log<%= auditLogQs(page - 1) %>"><%= t('auditLogPrev') %></a>
    <% } else { %>
      <span></span>
    <% } %>
    <% if (page < totalPages) { %>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/audit-log<%= auditLogQs(page + 1) %>"><%= t('auditLogNext') %></a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
  <% } %>
<% } %>

<% if (typeof canDeleteAuditLog !== 'undefined' && canDeleteAuditLog) { %>
<div class="modal fade" id="auditDeleteModal" tabindex="-1" aria-labelledby="auditDeleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
    <div class="modal-content tm-audit-delete-modal border-0 shadow-lg overflow-hidden">
      <div class="tm-audit-delete-modal__header text-center py-4 px-3">
        <div class="tm-audit-delete-modal__icon mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle">
          <i class="bi bi-shield-exclamation fs-3"></i>
        </div>
        <h2 class="h5 mb-1 fw-semibold text-dark" id="auditDeleteModalLabel"><%= t('auditLogDeleteModalTitle') %></h2>
        <p class="small text-muted mb-0 px-1"><%= t('auditLogDeleteConfirm') %></p>
        <p class="small text-danger mb-0 mt-2 fw-medium"><%= t('auditLogDeleteModalHint') %></p>
      </div>
      <div class="modal-footer flex-wrap justify-content-center gap-2 border-0 pt-0 pb-4 px-3 bg-white">
        <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal"><%= t('cancel') %></button>
        <button type="button" class="btn btn-danger px-4 fw-semibold" id="auditDeleteModalConfirm">
          <i class="bi bi-trash me-1"></i><%= t('auditLogDelete') %>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .tm-audit-delete-modal {
    border-radius: 1rem;
  }
  .tm-audit-delete-modal__header {
    background: linear-gradient(135deg, #facc15 0%, #eab308 55%, #fde047 100%);
  }
  .tm-audit-delete-modal__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.55);
    color: #854d0e;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
</style>

<script>
(function () {
  function initAuditDeleteModal() {
    if (typeof bootstrap === 'undefined') {
      console.warn('[audit-log] Bootstrap not loaded; delete modal disabled.');
      return;
    }
    var modalEl = document.getElementById('auditDeleteModal');
    if (!modalEl) return;
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    var pendingForm = null;
    document.querySelectorAll('.js-audit-delete-open').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var fid = btn.getAttribute('data-form-id');
        pendingForm = fid ? document.getElementById(fid) : null;
        modal.show();
      });
    });
    var confirmBtn = document.getElementById('auditDeleteModalConfirm');
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function () {
        if (pendingForm) pendingForm.submit();
        pendingForm = null;
        modal.hide();
      });
    }
    modalEl.addEventListener('hidden.bs.modal', function () {
      pendingForm = null;
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuditDeleteModal);
  } else {
    initAuditDeleteModal();
  }
})();
</script>
<% } %>
