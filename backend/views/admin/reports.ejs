                <label class="form-check-label" for="ft-municipality"><%= t('municipality') %></label>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <input class="form-check-input filter-type-checkbox" type="checkbox" value="city" id="ft-city" <%= selectedFilterTypes.includes('city') ? 'checked' : '' %>>
                <label class="form-check-label" for="ft-city"><%= t('city') %></label>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <input class="form-check-input filter-type-checkbox" type="checkbox" value="region" id="ft-region" <%= selectedFilterTypes.includes('region') ? 'checked' : '' %>>
                <label class="form-check-label" for="ft-region"><%= t('region') %></label>
              </div>
            </div>
            <div class="col-6">
