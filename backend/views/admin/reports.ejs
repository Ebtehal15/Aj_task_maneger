<%
  const formatDateOnlyTurkey = (date) => {
    if (!date) return '';
    try {
      const dateObj = typeof date === 'string' ? new Date(date) : date;
      const turkeyOffset = 3 * 60;
      const utc = dateObj.getTime() + (dateObj.getTimezoneOffset() * 60000);
      const turkeyTime = new Date(utc + (turkeyOffset * 60000));
      const year = turkeyTime.getFullYear();
      const month = String(turkeyTime.getMonth() + 1).padStart(2, '0');
      const day = String(turkeyTime.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    } catch (err) {
      return typeof date === 'string'
        ? date.slice(0, 10)
        : date.toISOString().slice(0, 10);
    }
  };
%>

<script>
  // Sayfa yüklenmeden önce varsayılan görünümü belirle (FOUC önlemek için)
  (function() {
    const isMobile = window.innerWidth < 768;
    const storageKey = isMobile ? 'taskViewPreferenceMobile' : 'taskViewPreferenceDesktop';
    const savedView = localStorage.getItem(storageKey);
    const defaultView = savedView || (isMobile ? 'card' : 'table');
    
    // HTML'e data attribute ekle
    document.documentElement.setAttribute('data-default-view', defaultView);
  })();
</script>

