<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-2">
    <h1 class="h4 mb-0"><%= t('myTasks') %></h1>
  </div>
  <div class="d-flex align-items-center gap-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
      <button type="button" class="btn btn-outline-secondary active" id="view-table-btn">
        <i class="bi bi-table"></i>
      </button>
      <button type="button" class="btn btn-outline-secondary" id="view-card-btn">
        <i class="bi bi-grid-3x3-gap"></i>
      </button>
    </div>
    <a href="/creator/tasks/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-circle"></i> <%= t('createTask') %>
    </a>
  </div>
</div>

<form class="card card-body shadow-sm mb-3" method="get" id="filterForm">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label"><%= t('filterByStatus') %></label>
      <select name="status" class="form-select filter-input">
        <option value="">--</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>
          <%= t('status_pending') %>
        </option>
        <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>
          <%= t('status_in_progress') %>
        </option>
        <option value="done" <%= filters.status === 'done' ? 'selected' : '' %>>
          <%= t('status_done') %>
        </option>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label"><%= t('filterByDate') %> (from)</label>
      <input type="date" name="from" value="<%= filters.from || '' %>" class="form-control filter-input" />
    </div>
    <div class="col-md-3">
      <label class="form-label"><%= t('filterByDate') %> (to)</label>
      <input type="date" name="to" value="<%= filters.to || '' %>" class="form-control filter-input" />
    </div>
    <div class="col-md-2 text-end">
      <button type="button" class="btn btn-primary mt-3" style="display: none;"><%= t('save') %></button>
    </div>
  </div>
</form>

<script>
  // Filtreleme formunu otomatik submit et
  (function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
      const filterInputs = filterForm.querySelectorAll('.filter-input');
      let submitTimeout;
      
      filterInputs.forEach(input => {
        input.addEventListener('change', function() {
          // Debounce: Kullanıcı yazmayı bitirdikten 300ms sonra submit et
          clearTimeout(submitTimeout);
          submitTimeout = setTimeout(() => {
            filterForm.submit();
          }, 300);
        });
      });
    }
  })();
</script>

<% if (typeof tasks !== 'undefined') { %>
<div class="mb-2 small text-muted">
  <strong><%= t('resultsCount') %>:</strong> <%= tasks.length %>
</div>
<% } %>

<%
  const formatDateOnlyTurkey = (date) => {
    if (!date) return '';
    try {
      const dateObj = typeof date === 'string' ? new Date(date) : date;
      const turkeyOffset = 3 * 60;
      const utc = dateObj.getTime() + (dateObj.getTimezoneOffset() * 60000);
      const turkeyTime = new Date(utc + (turkeyOffset * 60000));
      const year = turkeyTime.getFullYear();
      const month = String(turkeyTime.getMonth() + 1).padStart(2, '0');
      const day = String(turkeyTime.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    } catch (err) {
      return typeof date === 'string'
        ? date.slice(0, 10)
        : date.toISOString().slice(0, 10);
    }
  };
%>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <% if (!tasks.length) { %>
    <p class="p-3 mb-0 text-muted"><%= t('noTasks') %></p>
    <% } else { %>
    <!-- Tablo görünümü -->
    <div class="table-responsive" id="tasks-table-view">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th><%= t('taskTitle') %></th>
            <th><%= t('konuSorumlusu') %></th>
            <th><%= t('departman') %></th>
            <th><%= t('status') %></th>
            <th><%= t('deadline') %></th>
            <th><%= t('completedAt') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach((task, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td>
              <div><strong><%= task.title %></strong></div>
              <% if (task.task_subject && task.task_subject.trim()) { %>
              <div class="small text-muted mt-1"><%= task.task_subject %></div>
              <% } %>
              <% if (task.acil === true || task.acil === 'true' || task.acil === 't') { %>
                <span class="badge bg-danger ms-2"><%= t('urgent') %></span>
              <% } %>
            </td>
            <td><%= task.konu_sorumlusu_username || task.assigned_username || '-' %></td>
            <td><%= task.departman || '-' %></td>
            <td>
              <span class="badge status-<%= task.status %>">
                <%= t('status_' + task.status) %>
              </span>
            </td>
            <td><%= task.deadline ? formatDateOnlyTurkey(task.deadline) : '-' %></td>
            <td><%= task.completed_at ? formatDateOnlyTurkey(task.completed_at) : '-' %></td>
            <td class="text-end">
              <a href="/creator/tasks/<%= task.id %>" class="btn btn-sm btn-outline-primary">
                <%= t('view') %>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Kart görünümü -->
    <div class="p-3" id="tasks-card-view" style="display:none;">
      <div class="row g-3">
        <% tasks.forEach((task, index) => { %>
        <div class="col-12 col-md-6 col-xl-4">
          <div class="card h-100 shadow-sm border-0" style="border-radius: 1rem;">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="small text-muted mb-1">#<%= index + 1 %></div>
                  <h2 class="h6 mb-0"><%= task.title %></h2>
                  <% if (task.task_subject && task.task_subject.trim()) { %>
                  <div class="small text-muted mt-1"><%= task.task_subject %></div>
                  <% } %>
                </div>
                <div class="text-end">
                  <% if (task.acil === true || task.acil === 'true' || task.acil === 't') { %>
                  <span class="badge bg-danger mb-1 d-block"><%= t('urgent') %></span>
                  <% } %>
                  <span class="badge status-<%= task.status %>">
                    <%= t('status_' + task.status) %>
                  </span>
                </div>
              </div>

              <div class="mb-2 small text-muted">
                <div>
                  <strong><%= t('konuSorumlusu') %>:</strong>
                  <span><%= task.konu_sorumlusu_username || task.assigned_username || '-' %></span>
                </div>
                <div>
                  <strong><%= t('departman') %>:</strong>
                  <span><%= task.departman || '-' %></span>
                </div>
              </div>

              <div class="mb-3 small">
                <div>
                  <strong><%= t('deadline') %>:</strong>
                  <span><%= task.deadline ? formatDateOnlyTurkey(task.deadline) : '-' %></span>
                </div>
                <div>
                  <strong><%= t('completedAt') %>:</strong>
                  <span><%= task.completed_at ? formatDateOnlyTurkey(task.completed_at) : '-' %></span>
                </div>
              </div>

              <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                  <i class="bi bi-person-circle me-1"></i>
                  <%= task.konu_sorumlusu_username || task.assigned_username || '-' %>
                </span>
                <a href="/creator/tasks/<%= task.id %>" class="btn btn-sm btn-outline-primary">
                  <%= t('view') %>
                </a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tableView = document.getElementById('tasks-table-view');
    const cardView = document.getElementById('tasks-card-view');
    const tableBtn = document.getElementById('view-table-btn');
    const cardBtn = document.getElementById('view-card-btn');

    if (!tableView || !cardView || !tableBtn || !cardBtn) return;

    function setView(mode) {
      if (mode === 'card') {
        tableView.style.display = 'none';
        cardView.style.display = 'block';
        cardBtn.classList.add('active');
        tableBtn.classList.remove('active');
        localStorage.setItem('creatorTasksViewMode', 'card');
      } else {
        tableView.style.display = 'block';
        cardView.style.display = 'none';
        tableBtn.classList.add('active');
        cardBtn.classList.remove('active');
        localStorage.setItem('creatorTasksViewMode', 'table');
      }
    }

    tableBtn.addEventListener('click', () => setView('table'));
    cardBtn.addEventListener('click', () => setView('card'));

    // İlk yüklemede son seçilen görünümü uygula
    const savedMode = localStorage.getItem('creatorTasksViewMode') || 'table';
    setView(savedMode);
  });
</script>

