<%
  const totalAll = totals?.total ?? 0;
  const doneAll = totals?.done ?? 0;
  const pendingAll = totals?.pending ?? 0;
  const inProgressAll = totals?.in_progress ?? 0;
  const overdueAll = totals?.overdue ?? 0;
  const urgentAll = totals?.urgent ?? 0;
  const completionAll = totalAll > 0 ? Math.round((doneAll / totalAll) * 100) : 0;
  const completionAllBarClass = completionAll > 50 ? 'tm-progress__bar--green' : (completionAll === 50 ? 'tm-progress__bar--amber' : 'tm-progress__bar--red');
%>

<div class="d-flex justify-content-between align-items-center mb-3 td-header">
  <div>
    <h1 class="h4 mb-1"><i class="bi bi-diagram-3 me-2"></i><%= t('taskDistribution') %></h1>
    <div class="small text-muted"><%= t('evaluation') %> • <span class="fw-semibold"><%= completionAll %>%</span> <%= t('completionRate') %></div>
  </div>
  <div class="d-flex align-items-center gap-2 td-header-actions">
    <% if (rows && rows.length) { %>
      <div class="btn-group td-view-toggle" role="group" aria-label="View mode">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="tdViewCardsBtn">
          <i class="bi bi-grid-3x3-gap me-1"></i><%= t('cardView') %>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="tdViewTableBtn">
          <i class="bi bi-table me-1"></i><%= t('tableView') %>
        </button>
      </div>
    <% } %>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">← <%= t('back') %></a>
  </div>
</div>

<div class="tm-kpi-grid mb-3">
  <div class="tm-kpi-col">
    <div class="tm-kpi-card tm-kpi-accent--blue">
      <div class="tm-kpi-card__body">
        <div class="tm-kpi-card__top">
          <div>
            <div class="tm-kpi-card__label"><%= t('totalTasks') %></div>
            <div class="tm-kpi-card__value"><%= totalAll %></div>
          </div>
          <div class="tm-kpi-icon"><i class="bi bi-stack"></i></div>
        </div>
        <div class="tm-kpi-sub">
          <span class="tm-pill"><i class="bi bi-check2-circle"></i> <%= doneAll %></span>
          <span class="tm-pill"><i class="bi bi-hourglass-split"></i> <%= pendingAll + inProgressAll %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="tm-kpi-col">
    <div class="tm-kpi-card tm-kpi-accent--green">
      <div class="tm-kpi-card__body">
        <div class="tm-kpi-card__top">
          <div>
            <div class="tm-kpi-card__label"><%= t('completionRate') %></div>
            <div class="tm-kpi-card__value"><%= completionAll %>%</div>
          </div>
          <div class="tm-kpi-icon"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
        <div class="tm-kpi-sub w-100">
          <div class="tm-progress w-100" aria-label="<%= t('completionRate') %>">
            <div class="tm-progress__bar <%= completionAllBarClass %>" style="width: <%= completionAll %>%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tm-kpi-col">
    <a href="/admin/reports?overdue=true" class="text-decoration-none text-reset">
      <div class="tm-kpi-card tm-kpi-accent--red" style="cursor: pointer;">
        <div class="tm-kpi-card__body">
          <div class="tm-kpi-card__top">
            <div>
              <div class="tm-kpi-card__label"><%= t('overdueTasks') %></div>
              <div class="tm-kpi-card__value"><%= overdueAll %></div>
            </div>
            <div class="tm-kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
          </div>
          <div class="tm-kpi-sub">
            <span class="tm-pill tm-pill--red"><i class="bi bi-clock-history"></i> <%= overdueAll %></span>
          </div>
        </div>
      </div>
    </a>
  </div>

  <div class="tm-kpi-col">
    <div class="tm-kpi-card tm-kpi-accent--amber">
      <div class="tm-kpi-card__body">
        <div class="tm-kpi-card__top">
          <div>
            <div class="tm-kpi-card__label"><%= t('urgentTasks') %></div>
            <div class="tm-kpi-card__value"><%= urgentAll %></div>
          </div>
          <div class="tm-kpi-icon"><i class="bi bi-lightning-charge"></i></div>
        </div>
        <div class="tm-kpi-sub">
          <span class="tm-pill tm-pill--amber"><i class="bi bi-lightning"></i> <%= urgentAll %></span>
          <span class="tm-pill"><i class="bi bi-shield-check"></i> AJ</span>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (rows && rows.length) { %>
  <div class="card shadow-sm tm-kpi-card mb-3">
    <div class="card-body">
      <h2 class="h6 mb-2 d-flex align-items-center gap-2">
        <i class="bi bi-bar-chart-steps text-primary"></i>
        <span>En Çok Görev Tamamlayanlar</span>
      </h2>
      <div id="tdDoneChart" class="tm-bar-chart"></div>
      <hr class="my-3" />
      <h2 class="h6 mb-2 d-flex align-items-center gap-2">
        <i class="bi bi-clock-history text-danger"></i>
        <span>En Çok Geciken Görevi Olanlar</span>
      </h2>
      <div id="tdOverdueChart" class="tm-bar-chart"></div>
      <hr class="my-3" />
      <h2 class="h6 mb-2 d-flex align-items-center gap-2">
        <i class="bi bi-lightning-charge text-warning"></i>
        <span>En Çok Acil Görevi Olanlar</span>
      </h2>
      <div id="tdUrgentChart" class="tm-bar-chart"></div>
    </div>
  </div>
<% } %>

<% if (!rows || !rows.length) { %>
  <div class="card shadow-sm tm-kpi-card">
    <div class="card-body">
      <p class="mb-0 text-muted"><%= t('noTasks') %></p>
    </div>
  </div>
<% } else { %>
  <!-- Cards view -->
  <div id="tdCardsView">
    <div class="tm-user-cards">
      <% rows.forEach((r) => { %>
        <%
          const total = r.total ?? 0;
          const done = r.done ?? 0;
          const overdue = r.overdue ?? 0;
          const urgent = r.urgent ?? 0;
          // Başarı oranı: tamamlanma oranı * hacim faktörü
          // - Tamamlanma oranı: done / total
          // - Hacim faktörü: done / (done + 5)  -> daha çok görev tamamlayanlar daha yüksek puan alır
          const completionRatio = total > 0 ? (done / total) : 0;
          const volumeFactor = done > 0 ? (done / (done + 5)) : 0;
          const successRaw = completionRatio * volumeFactor * 100;
          const success = Math.max(0, Math.min(100, Math.round(successRaw)));
          const initial = (r.username || '?').toString().trim().charAt(0).toUpperCase();
        %>
        <div class="tm-user-card-col">
          <div class="tm-user-card tm-user-card--collapsed" role="button" tabindex="0" aria-expanded="false">
            <div class="tm-user-card__body">
              <div class="tm-user-card__topline">
                <div class="tm-user-card__who">
                  <div class="tm-user-avatar" aria-hidden="true"><%= initial %></div>
                  <div style="min-width:0;">
                    <div class="tm-user-card__name"><%= r.username %></div>
                    <div class="tm-user-card__meta">
                      <span class="tm-td-muted"><%= done %></span>/<span class="tm-td-muted"><%= total %></span> <%= t('status_done') %>
                    </div>
                  </div>
                </div>

                <div class="tm-user-card__rate" title="Başarı Oranı">
                  <b><%= success %>%</b>
                  <span class="tm-user-card__chev" aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                </div>
              </div>

              <div class="tm-progress" aria-label="Başarı Oranı">
                <div class="tm-progress__bar <%= success > 50 ? 'tm-progress__bar--green' : (success === 50 ? 'tm-progress__bar--amber' : 'tm-progress__bar--red') %>" style="width: <%= success %>%;"></div>
              </div>

              <div class="tm-user-card__details">
                <div class="tm-user-card__divider"></div>
                <div class="tm-metric-grid">
                  <div class="tm-metric">
                    <a href="/admin/reports?userId=<%= r.id %>" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-stack"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= total %></span>
                    </a>
                  </div>

                  <div class="tm-metric">
                    <a href="/admin/reports?userId=<%= r.id %>&status=pending" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-hourglass"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= r.pending %></span>
                    </a>
                  </div>

                  <div class="tm-metric">
                    <a href="/admin/reports?userId=<%= r.id %>&status=in_progress" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-play-circle"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= r.in_progress %></span>
                    </a>
                  </div>

                  <div class="tm-metric tm-metric--green">
                    <a href="/admin/reports?userId=<%= r.id %>&status=done" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-check-circle"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= done %></span>
                    </a>
                  </div>

                  <div class="tm-metric tm-metric--red">
                    <a href="/admin/reports?userId=<%= r.id %>&overdue=true" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-clock-history"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= overdue %></span>
                    </a>
                  </div>

                  <div class="tm-metric tm-metric--amber">
                    <a href="/admin/reports?userId=<%= r.id %>&urgent=true" class="tm-metric__link text-decoration-none text-reset">
                      <div class="tm-metric__left">
                        <span class="tm-metric__icon"><i class="bi bi-lightning"></i></span>
                        <span class="tm-metric__label"></span>
                      </div>
                      <span class="tm-metric__value"><%= urgent %></span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Table view -->
  <div id="tdTableView" style="display:none;">
    <div class="card shadow-sm tm-kpi-card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 tm-table-soft">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th><%= t('personnel') %></th>
              <th class="text-center"><%= t('totalTasks') %></th>
              <th class="text-center"><%= t('status_pending') %></th>
              <th class="text-center"><%= t('status_in_progress') %></th>
              <th class="text-center"><%= t('status_done') %></th>
              <th class="text-center"><%= t('overdueTasks') %></th>
              <th class="text-center"><%= t('urgentTasks') %></th>
              <th class="text-center">Başarı Oranı</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((r, idx) => { %>
              <%
                const total = r.total ?? 0;
                const done = r.done ?? 0;
                const overdue = r.overdue ?? 0;
                const urgent = r.urgent ?? 0;
                const completionRatio = total > 0 ? (done / total) : 0;
                const volumeFactor = done > 0 ? (done / (done + 5)) : 0;
                const successRaw = completionRatio * volumeFactor * 100;
                const success = Math.max(0, Math.min(100, Math.round(successRaw)));
                const rank = idx + 1;
                const rankClass = rank === 1 ? 'tm-rank tm-rank--1' : rank === 2 ? 'tm-rank tm-rank--2' : rank === 3 ? 'tm-rank tm-rank--3' : '';
              %>
              <tr class="<%= rank <= 3 ? 'tm-top-row' : '' %>">
                <td>
                  <span class="<%= rankClass %>"><%= rank %></span>
                </td>
                <td>
                  <div class="fw-bold"><%= r.username %></div>
                  <div class="small text-muted">
                    <span class="tm-td-muted"><%= done %></span>/<span class="tm-td-muted"><%= total %></span> <%= t('status_done') %>
                  </div>
                </td>
                <td class="text-center fw-semibold">
                  <a href="/admin/reports?userId=<%= r.id %>" class="text-decoration-none text-reset"><%= total %></a>
                </td>
                <td class="text-center">
                  <a href="/admin/reports?userId=<%= r.id %>&status=pending" class="text-decoration-none text-reset">
                    <span class="tm-pill"><i class="bi bi-hourglass"></i> <%= r.pending %></span>
                  </a>
                </td>
                <td class="text-center">
                  <a href="/admin/reports?userId=<%= r.id %>&status=in_progress" class="text-decoration-none text-reset">
                    <span class="tm-pill"><i class="bi bi-play-circle"></i> <%= r.in_progress %></span>
                  </a>
                </td>
                <td class="text-center">
                  <a href="/admin/reports?userId=<%= r.id %>&status=done" class="text-decoration-none text-reset">
                    <span class="tm-pill tm-pill--green"><i class="bi bi-check-circle"></i> <%= done %></span>
                  </a>
                </td>
                <td class="text-center">
                  <% if (overdue > 0) { %>
                    <a href="/admin/reports?userId=<%= r.id %>&overdue=true" class="text-decoration-none text-reset">
                      <span class="tm-pill tm-pill--red"><i class="bi bi-clock-history"></i> <%= overdue %></span>
                    </a>
                  <% } else { %>
                    <span class="tm-pill"><i class="bi bi-check2"></i> 0</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (urgent > 0) { %>
                    <a href="/admin/reports?userId=<%= r.id %>&urgent=true" class="text-decoration-none text-reset">
                      <span class="tm-pill tm-pill--amber"><i class="bi bi-lightning"></i> <%= urgent %></span>
                    </a>
                  <% } else { %>
                    <span class="tm-pill"><i class="bi bi-dash"></i> 0</span>
                  <% } %>
                </td>
                <td class="text-center" style="min-width: 160px;">
                  <div class="d-flex align-items-center gap-2 justify-content-center">
                    <div class="tm-progress" style="width: 110px;">
                      <div class="tm-progress__bar <%= success > 50 ? 'tm-progress__bar--green' : (success === 50 ? 'tm-progress__bar--amber' : 'tm-progress__bar--red') %>" style="width: <%= success %>%;"></div>
                    </div>
                    <span class="fw-bold"><%= success %>%</span>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script>
  (function () {
    // Generic horizontal bar chart renderer
    (function () {
      var rawData = <%- JSON.stringify(rows || []) %>;
      if (!rawData || !rawData.length) return;

      function renderBarChart(opts) {
        var container = document.getElementById(opts.containerId);
        if (!container) return;

        var items = rawData
          .map(function (r) {
            return {
              name: r.username || '',
              value: Number(opts.selector(r) || 0)
            };
          })
          .filter(function (x) { return x.value > 0; })
          .sort(function (a, b) {
            if (b.value !== a.value) return b.value - a.value;
            return (a.name || '').localeCompare(b.name || '', 'tr');
          });

        if (!items.length) {
          container.innerHTML = '<p class="text-muted small mb-0">Henüz veri yok.</p>';
          return;
        }

        var maxVal = items[0].value || 1;
        var MAX_VISIBLE = 5;
        var hiddenRows = [];

        items.forEach(function (item, idx) {
          var row = document.createElement('div');
          row.className = 'tm-bar-row';

          var label = document.createElement('div');
          label.className = 'tm-bar-row-label';
          label.textContent = (idx + 1) + '. ' + (item.name || '');

          var track = document.createElement('div');
          track.className = 'tm-bar-row-track';

          var fill = document.createElement('div');
          fill.className = opts.fillClass || 'tm-bar-row-fill';
          var width = Math.max(8, (item.value / maxVal) * 100);
          fill.style.width = width + '%';

          track.appendChild(fill);

          var value = document.createElement('div');
          value.className = 'tm-bar-row-value';
          value.textContent = item.value;

          row.appendChild(label);
          row.appendChild(track);
          row.appendChild(value);

          if (idx < MAX_VISIBLE) {
            container.appendChild(row);
          } else {
            row.style.display = 'none';
            hiddenRows.push(row);
            container.appendChild(row);
          }
        });

        if (hiddenRows.length) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn btn-sm btn-outline-secondary mt-2';
          btn.textContent = 'Fazlasını Göster';
          var expanded = false;
          btn.addEventListener('click', function () {
            expanded = !expanded;
            hiddenRows.forEach(function (row) {
              row.style.display = expanded ? 'flex' : 'none';
            });
            btn.textContent = expanded ? 'Daha Az Göster' : 'Fazlasını Göster';
          });
          container.appendChild(btn);
        }
      }

      // Tamamlanan görevler
      renderBarChart({
        containerId: 'tdDoneChart',
        selector: function (r) { return r.done; },
        fillClass: 'tm-bar-row-fill'
      });

      // Geciken görevler
      renderBarChart({
        containerId: 'tdOverdueChart',
        selector: function (r) { return r.overdue; },
        fillClass: 'tm-bar-row-fill--overdue'
      });

      // Acil görevler
      renderBarChart({
        containerId: 'tdUrgentChart',
        selector: function (r) { return r.urgent; },
        fillClass: 'tm-bar-row-fill--urgent'
      });
    })();

    var cards = document.getElementById('tdCardsView');
    var table = document.getElementById('tdTableView');
    var btnCards = document.getElementById('tdViewCardsBtn');
    var btnTable = document.getElementById('tdViewTableBtn');
    if (!cards || !table || !btnCards || !btnTable) return;

    var KEY = 'taskDistributionViewMode';

    function setMode(mode) {
      var isCards = mode === 'cards';
      cards.style.display = isCards ? '' : 'none';
      table.style.display = isCards ? 'none' : '';
      btnCards.classList.toggle('active', isCards);
      btnTable.classList.toggle('active', !isCards);
      try { localStorage.setItem(KEY, mode); } catch (e) {}
    }

    btnCards.addEventListener('click', function () { setMode('cards'); });
    btnTable.addEventListener('click', function () { setMode('table'); });

    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    setMode(saved === 'table' ? 'table' : 'cards');

    function toggleCard(el) {
      var isCollapsed = el.classList.contains('tm-user-card--collapsed');
      if (isCollapsed) {
        el.classList.remove('tm-user-card--collapsed');
        el.classList.add('tm-user-card--expanded');
        el.setAttribute('aria-expanded', 'true');
      } else {
        el.classList.add('tm-user-card--collapsed');
        el.classList.remove('tm-user-card--expanded');
        el.setAttribute('aria-expanded', 'false');
      }
    }

    // Expand/collapse user cards (cards view) – kartın kendisine tıklayınca
    var cardNodes = cards.querySelectorAll('.tm-user-card');
    cardNodes.forEach(function(card) {
      card.addEventListener('click', function (e) {
        var tag = (e.target.tagName || '').toLowerCase();
        if (tag === 'a' || tag === 'button') return;
        toggleCard(card);
      });

      card.addEventListener('keydown', function (e) {
        var key = e.key || e.code;
        if (key !== 'Enter' && key !== ' ' && key !== 'Spacebar') return;
        e.preventDefault();
        toggleCard(card);
      });
    });
  })();
</script>

