        <% users.forEach(u => { %>
        <option value="<%= u.id %>" <%= filters.userId == u.id ? 'selected' : '' %>>
          <%= u.username %>
        </option>
        <% }) %>
      </select>
    </div>
    <% } %>
    
    <!-- Status Filter -->
