          data-bs-toggle="dropdown"
          data-bs-auto-close="outside"
          aria-expanded="false"
          id="filtersDropdownBtn"
          data-base-label="<%= t('filters') %>"
        >
          <i class="bi bi-funnel"></i>
          <span id="filtersDropdownLabel"><%= t('filters') %></span>
        </button>
        <div class="dropdown-menu p-3 shadow-sm" style="min-width: 320px;">
