# Kopyalayın: copy .env.example .env  ve değerleri doldurun.

# Oturum süresi (dakika). Her istekte yenilenir (rolling); hareketsizlikte bu süre sonunda oturum düşer.
# Varsayılan: 20. Üst sınır: 1440 (24 saat).
SESSION_MAX_AGE_MINUTES=20

# Üretimde güçlü bir değer kullanın.
# SESSION_SECRET=

# DATABASE_URL=postgresql://user:pass@host:5432/dbname
