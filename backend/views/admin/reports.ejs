<script>
  // Kullanıcı Raporları: seçili kullanıcıları localStorage'da sakla ve sayfadan çıkıp gelsede koru
  (function() {
    const STORAGE_KEY = 'adminUserReportsSelectedIds';
    const form = document.getElementById('userReportsSelectForm');
    const checkboxes = document.querySelectorAll('.user-id-checkbox');
    const isUsersTab = '<%= activeTab === 'users' ? '1' : '0' %>' === '1';
    const hasServerSelected =
      <%= (typeof selectedUserIds !== 'undefined' && selectedUserIds.length) ? 'true' : 'false' %>;
    const serverSelectedParam = '<%= typeof selectedUserIdsParam !== 'undefined' ? selectedUserIdsParam : '' %>';

    function getCheckedIds() {
      const ids = [];
      checkboxes.forEach(cb => {
        if (cb.checked) {
          const v = parseInt(cb.value, 10);
          if (!isNaN(v)) ids.push(v);
        }
      });
      return ids;
    }

    if (form) {
      form.addEventListener('submit', function() {
        const ids = getCheckedIds();
        try {
          localStorage.setItem(STORAGE_KEY, ids.join(','));
        } catch (e) {
          // ignore
        }
      });
    }

    // Eğer kullanıcı sekmesindeyiz ve server tarafında seçili kullanıcı yoksa,
    // fakat localStorage'da daha önce seçilmiş kullanıcılar varsa otomatik uygula.
    if (isUsersTab && !hasServerSelected) {
      let stored = '';
      try {
        stored = localStorage.getItem(STORAGE_KEY) || '';
      } catch (e) {
        stored = '';
      }
      if (stored && stored.trim()) {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', 'users');
        url.searchParams.set('userIds', stored);
        // Tek bir kullanıcı filtresi olmasın, sadece liste görünsün
        url.searchParams.delete('userId');
        window.location.replace(url.toString());
      }
    }

    // Eğer server tarafında seçili kullanıcı listesi varsa, localStorage ile senkronize et
    if (isUsersTab && hasServerSelected && serverSelectedParam) {
      try {
        localStorage.setItem(STORAGE_KEY, serverSelectedParam);
      } catch (e) {
        // ignore
      }
    }
  })();
</script>

