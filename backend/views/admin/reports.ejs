              <i class="bi bi-activity text-primary"></i>
              <span><%= tSafe('createdVsCompletedTrend') %></span>
            </h3>
            <div id="chart-created-completed-trend" class="tm-trend-chart"></div>
          </div>
        </div>
      </div>
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <h3 class="h6 mb-1 d-flex align-items-center gap-2">
              <i class="bi bi-trophy-fill text-warning"></i>
              <span><%= tSafe('topPerformersTitle') %></span>
            </h3>
            <p class="small text-muted mb-3"><%= tSafe('topPerformersSubtitle') %></p>
            <div id="top-performers-board" class="tm-top-performers-board"></div>
          </div>
        </div>
      </div>
      <% } %>
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <h3 class="h6 mb-2 d-flex align-items-center gap-2">
              <i class="bi bi-journal-text text-primary"></i>
              <span><%= tSafe('overdueByTopicDaysChart') %></span>
