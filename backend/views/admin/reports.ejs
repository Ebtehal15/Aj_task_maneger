<script>
  // Raporlar tablosunda departman, konu sorumlusu veya başlığa göre sıralama
  (function() {
    const sortSelect = document.getElementById('reportsSortSelect');
    const table = document.getElementById('reportsTable');
    if (!table) return;

    const tbody = table.querySelector('tbody');
    if (!tbody) return;

    // İlk yüklemede orijinal sıralamayı kaydet
    const originalRows = Array.from(tbody.querySelectorAll('tr'));
    originalRows.forEach((row, idx) => {
      row.setAttribute('data-original-index', String(idx));
    });

    function getCellText(row, index, isTitleCell = false) {
      const cell = row.children[index];
      if (!cell) return '';
      if (isTitleCell) {
        const strong = cell.querySelector('strong');
        if (strong && strong.textContent) return strong.textContent.trim();
      }
      return (cell.textContent || '').trim();
    }

    function resort(value) {
      if (!value && sortSelect) {
        value = sortSelect.value;
      }
      // Sıralamayı kaldır (orijinal sıraya dön)
      if (!value || value === 'none') {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort((a, b) => {
          const aIdx = parseInt(a.getAttribute('data-original-index') || '0', 10);
          const bIdx = parseInt(b.getAttribute('data-original-index') || '0', 10);
          return aIdx - bIdx;
        });
        rows.forEach((row, idx) => {
          const indexCell = row.children[0];
          if (indexCell) indexCell.textContent = String(idx + 1);
          tbody.appendChild(row);
        });

        // Tüm kolonlardaki ok işaretlerini temizle
        const headers = table.querySelectorAll('th.sortable-column');
        headers.forEach(th => {
          const indicator = th.querySelector('.sort-indicator');
          if (indicator) indicator.textContent = '';
        });
        return;
      }

      const [field] = value.split('-'); // departman-asc, konu-asc
      const dir = 'asc';
      const rows = Array.from(tbody.querySelectorAll('tr'));

      let columnIndex = 0;
      let isTitleCell = false;

      // Kolon indexleri: #, Başlık, Konu Sorumlusu, Departman, Durum, Deadline, Completed, CreatedBy, Aksiyon
      if (field === 'konu') {
        columnIndex = 2;
      } else if (field === 'departman') {
        columnIndex = 3;
      } else if (field === 'status') {
        columnIndex = 4;
      }

      rows.sort((a, b) => {
        // Duruma göre özel sıralama: pending -> in_progress -> done
        if (field === 'status') {
          const order = { pending: 1, in_progress: 2, done: 3 };
          const aStatus = (a.children[columnIndex].getAttribute('data-status') || '').toString();
          const bStatus = (b.children[columnIndex].getAttribute('data-status') || '').toString();
          const aVal = order[aStatus] || 99;
          const bVal = order[bStatus] || 99;
          if (aVal === bVal) return 0;
          return aVal < bVal ? -1 : 1;
        }

        const aText = getCellText(a, columnIndex, isTitleCell).toLocaleUpperCase('tr-TR');
        const bText = getCellText(b, columnIndex, isTitleCell).toLocaleUpperCase('tr-TR');

        if (aText === bText) return 0;
        const cmp = aText < bText ? -1 : 1;
        return cmp;
      });

      // Sıralanmış satırları tekrar tbody içine ekle
      rows.forEach((row, idx) => {
        // İlk kolon (sıra numarası) güncel olsun
        const indexCell = row.children[0];
        if (indexCell) indexCell.textContent = String(idx + 1);
        tbody.appendChild(row);
      });

      // Seçili kolon başlığındaki ok işaretini güncelle
      const headers = table.querySelectorAll('th.sortable-column');
      headers.forEach(th => {
        const indicator = th.querySelector('.sort-indicator');
        if (!indicator) return;
        const fieldAttr = th.getAttribute('data-sort-field');
        indicator.textContent = fieldAttr === field ? '▲' : '';
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        resort(this.value);
      });
    }

    // Kolon başlıklarına tıklayarak sıralama
    const headerColumns = table.querySelectorAll('th.sortable-column');
    headerColumns.forEach(th => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', function() {
        const field = this.getAttribute('data-sort-field');
        if (!field) return;
        let newValue = field + '-asc';
        if (sortSelect) {
          const current = sortSelect.value;
          // Aynı kolona tekrar tıklanırsa sıralamayı kaldır
          if (current === field + '-asc') {
            newValue = 'none';
          }
          sortSelect.value = newValue;
        }
        resort(newValue);
      });
    });

    // Excel export: mevcut sıralama ve kolon seçimlerini gönder
    const exportBtn = document.getElementById('exportExcelBtn');
    const excelColCheckboxes = document.querySelectorAll('.excel-col-checkbox');
    const EXCEL_COL_STORAGE_KEY = 'reportsExcelColumns';

    function getSelectedExcelColumns() {
      return Array.from(excelColCheckboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.value);
    }

    // Sayfa yüklenirken kolon seçimlerini localStorage'dan yükle
    if (excelColCheckboxes.length) {
      try {
        const raw = localStorage.getItem(EXCEL_COL_STORAGE_KEY);
        if (raw && raw.trim()) {
          const selected = raw.split(',').map(s => s.trim()).filter(Boolean);
          const selectedSet = new Set(selected);
          excelColCheckboxes.forEach(cb => {
            cb.checked = selectedSet.size ? selectedSet.has(cb.value) : true;
          });
        } else {
          // İlk kullanım: hepsini seçili yap
          excelColCheckboxes.forEach(cb => { cb.checked = true; });
        }
      } catch (e) {
        excelColCheckboxes.forEach(cb => { cb.checked = true; });
      }

      // Değiştikçe localStorage'a yaz
      excelColCheckboxes.forEach(cb => {
        cb.addEventListener('change', function() {
          const cols = getSelectedExcelColumns();
          try {
            localStorage.setItem(EXCEL_COL_STORAGE_KEY, cols.join(','));
          } catch (e) {
            // ignore
          }
        });
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', function() {
        try {
          const currentHref = this.getAttribute('href') || '/admin/reports/export';
          const url = new URL(currentHref, window.location.origin);
          const currentSort = sortSelect ? sortSelect.value : 'none';
          if (currentSort && currentSort !== 'none') {
            url.searchParams.set('sort', currentSort);
          } else {
            url.searchParams.delete('sort');
          }
          const cols = getSelectedExcelColumns();
          if (cols && cols.length) {
            url.searchParams.set('columns', cols.join(','));
          } else {
            url.searchParams.delete('columns');
          }
          this.setAttribute('href', url.toString());
        } catch (e) {
          // ignore; fallback to original href
        }
      });
    }
  })();
</script>

