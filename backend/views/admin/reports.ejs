<script>
  // Sekmelerin (Raporlar / Kullanıcı Raporları / Grafikler) URL'deki ?tab parametresine göre çalışması
  (function() {
    const params = new URLSearchParams(window.location.search);
    const tab = params.get('tab') || 'reports';

    const reportsLink = document.querySelector('a[data-tab="reports"]');
    const usersLink = document.querySelector('a[data-tab="users"]');
    const chartsLink = document.querySelector('a[data-tab="charts"]');

    const reportsContent = document.getElementById('reports-tab-content');
    const usersContent = document.getElementById('users-tab-content');
    const chartsContent = document.getElementById('charts-tab-content');

    function setActive(link, isActive) {
      if (!link) return;
      if (isActive) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    }

    function setVisible(el, isVisible) {
      if (!el) return;
      if (isVisible) {
        el.classList.remove('d-none');
      } else {
        el.classList.add('d-none');
      }
    }

    if (tab === 'users') {
      setActive(reportsLink, false);
      setActive(usersLink, true);
      setActive(chartsLink, false);

      setVisible(reportsContent, false);
      setVisible(usersContent, true);
      setVisible(chartsContent, false);
    } else if (tab === 'charts') {
      setActive(reportsLink, false);
      setActive(usersLink, false);
      setActive(chartsLink, true);

      setVisible(reportsContent, false);
      setVisible(usersContent, false);
      setVisible(chartsContent, true);
    } else {
      // varsayılan: raporlar
      setActive(reportsLink, true);
      setActive(usersLink, false);
      setActive(chartsLink, false);

      setVisible(reportsContent, true);
      setVisible(usersContent, false);
      setVisible(chartsContent, false);
    }
  })();
</script>

<script>
  // Kullanıcı Raporları: seçili kullanıcıları localStorage'da sakla ve sayfadan çıkıp gelsede koru
  (function() {
    const STORAGE_KEY = 'adminUserReportsSelectedIds';
    const form = document.getElementById('userReportsSelectForm');
    const checkboxes = document.querySelectorAll('.user-id-checkbox');
    const isUsersTab = "<%= activeTab === 'users' ? '1' : '0' %>" === '1';
    const hasServerSelected =
      <%= (typeof selectedUserIds !== 'undefined' && selectedUserIds.length) ? 'true' : 'false' %>;
    const serverSelectedParam = '<%= typeof selectedUserIdsParam !== 'undefined' ? selectedUserIdsParam : '' %>';

    function getCheckedIds() {
      const ids = [];
      checkboxes.forEach(cb => {
        if (cb.checked) {
          const v = parseInt(cb.value, 10);
          if (!isNaN(v)) ids.push(v);
        }
      });
      return ids;
    }

    if (form) {
      form.addEventListener('submit', function() {
        const ids = getCheckedIds();
        try {
          localStorage.setItem(STORAGE_KEY, ids.join(','));
        } catch (e) {
          // ignore
        }
      });
    }

    // Eğer kullanıcı sekmesindeyiz ve server tarafında seçili kullanıcı yoksa,
    // fakat localStorage'da daha önce seçilmiş kullanıcılar varsa otomatik uygula.
    if (isUsersTab && !hasServerSelected) {
      let stored = '';
      try {
        stored = localStorage.getItem(STORAGE_KEY) || '';
      } catch (e) {
        stored = '';
      }
      if (stored && stored.trim()) {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', 'users');
        url.searchParams.set('userIds', stored);
        // Tek bir kullanıcı filtresi olmasın, sadece liste görünsün
        url.searchParams.delete('userId');
        window.location.replace(url.toString());
      }
    }

    // Eğer server tarafında seçili kullanıcı listesi varsa, localStorage ile senkronize et
    if (isUsersTab && hasServerSelected && serverSelectedParam) {
      try {
        localStorage.setItem(STORAGE_KEY, serverSelectedParam);
      } catch (e) {
        // ignore
      }
    }
  })();
</script>

<script>
  // Grafikler sekmesi: profesyonel KPI + çoklu grafik senaryoları
  (function() {
    const params = new URLSearchParams(window.location.search);
    const isChartsTab = (params.get('tab') || 'reports') === 'charts';
    const isOverdueMode = <%= isOverdueView ? 'true' : 'false' %>;
    if (!isChartsTab) return;

    const tasks = <%- JSON.stringify(tasks || []) %>;
    const i18n = <%- JSON.stringify({
      noData: tSafe('noData'),
      other: tSafe('other'),
      statusLabel: t('status'),
      statusPending: t('status_pending'),
      statusInProgress: t('status_in_progress'),
      statusDone: t('status_done'),
      loading: tSafe('loading'),
      untitledTask: tSafe('untitledTask'),
      noOverdueTopicFound: tSafe('noOverdueTopicFound'),
      subjectOwnerLabel: tSafe('subjectOwnerLabel'),
      daysOverdueSuffix: tSafe('daysOverdueSuffix'),
      showMore: tSafe('showMore'),
      showLess: tSafe('showLess'),
      monthCreated: tSafe('monthCreated'),
      monthCompleted: tSafe('monthCompleted'),
      performanceScore: tSafe('performanceScore'),
      completionRate: tSafe('completionRate'),
      onTimeRate: tSafe('onTimeRate'),
      overdueRate: tSafe('overdueRate'),
      totalAssigned: tSafe('totalAssigned')
    }) %>;
    if (!Array.isArray(tasks) || !tasks.length) return;

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    function parseDate(value) {
      if (!value) return null;
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return null;
      d.setHours(0, 0, 0, 0);
      return d;
    }

    function isDone(task) {
      return task && task.status === 'done';
    }

    function isOpen(task) {
      return task && !isDone(task);
    }

    function isUrgent(task) {
      return (
        task &&
        (task.acil === true ||
          task.acil === 'true' ||
          task.acil === 't' ||
          task.acil === 1 ||
          task.acil === '1')
      );
    }

    function getOverdueDays(task) {
      if (!task || isDone(task)) return 0;
      const deadline = parseDate(task.deadline);
      if (!deadline) return 0;
      const diffMs = today.getTime() - deadline.getTime();
      return Math.floor(diffMs / (1000 * 60 * 60 * 24));
    }

    function isOverdue(task) {
      return getOverdueDays(task) > 0;
    }

    function isDueSoon(task, dayLimit = 3) {
      if (!task || isDone(task)) return false;
      const deadline = parseDate(task.deadline);
      if (!deadline) return false;
      const diffDays = Math.floor((deadline.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      return diffDays >= 0 && diffDays <= dayLimit;
    }

    function safeLabel(value) {
      return (String(value || '').trim() || i18n.other);
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function easeOutCubic(x) {
      return 1 - Math.pow(1 - x, 3);
    }

    function animateConicGradient(ringEl, segments, durationMs) {
      if (!ringEl || !Array.isArray(segments) || !segments.length) return;

      const start = performance.now();

      function render(progress) {
        let angleStart = 0;
        const gradientParts = segments.map(seg => {
          const finalAngle = seg.angle || 0;
          const currentAngle = finalAngle * progress;
          const angleEnd = angleStart + currentAngle;
          const part = `${seg.color} ${angleStart}deg ${angleEnd}deg`;
          angleStart = angleEnd;
          return part;
        });
        ringEl.style.background = `conic-gradient(${gradientParts.join(', ')})`;
      }

      function step(now) {
        const raw = Math.min((now - start) / durationMs, 1);
        const eased = easeOutCubic(raw);
        render(eased);
        if (raw < 1) requestAnimationFrame(step);
      }

      // 0 derece başlangıç
      render(0);
      requestAnimationFrame(step);
    }

    function aggregateBy(tasks, key, predicate) {
      const map = new Map();
      tasks.forEach(t => {
        if (typeof predicate === 'function' && !predicate(t)) return;
        const label = safeLabel(t[key]);
        map.set(label, (map.get(label) || 0) + 1);
      });
      return Array.from(map.entries())
        .map(([label, value]) => ({ label, value }))
        .sort((a, b) => b.value - a.value)
        .slice(0, 15);
    }

    function renderKpis() {
      const kpis = {
        total: tasks.length,
        open: tasks.filter(isOpen).length,
        completed: tasks.filter(isDone).length,
        overdue: tasks.filter(isOverdue).length,
        urgent: tasks.filter(isUrgent).length,
        dueSoon: tasks.filter(t => isDueSoon(t, 3)).length
      };

      const idMap = {
        total: 'kpi-total-tasks',
        open: 'kpi-open-tasks',
        completed: 'kpi-completed-tasks',
        overdue: 'kpi-overdue-tasks',
        urgent: 'kpi-urgent-tasks',
        dueSoon: 'kpi-due-soon-tasks'
      };

      Object.keys(idMap).forEach(key => {
        const el = document.getElementById(idMap[key]);
        if (el) el.textContent = String(kpis[key] || 0);
      });
    }

    function renderBarChart(containerId, items, { variant = 'default' } = {}) {
      const container = document.getElementById(containerId);
      if (!container) return;
      if (!items.length) {
        container.innerHTML =
          `<p class="small text-muted mb-0">${i18n.noData}</p>`;
        return;
      }

      const maxVal = Math.max(...items.map(i => i.value));
      const moreThanFive = items.length > 5;
      const visibleItems = items.slice(0, 5);

      function createRows(list) {
        return list
          .map(item => {
            const widthPercent = maxVal > 0 ? (item.value / maxVal) * 100 : 0;
            const classes = `tm-bar-row-fill tm-bar-row-fill--${variant}`;
            return `
              <div class="tm-bar-row">
                <div class="tm-bar-row-label" title="${item.label}">
                  ${item.label}
                </div>
                <div class="tm-bar-row-track">
                  <div class="${classes}" style="width: ${widthPercent}%"></div>
                </div>
                <div class="tm-bar-row-value">${item.value}</div>
              </div>
            `;
          })
          .join('');
      }

      let html = `<div class="tm-bar-chart-body" data-expanded="false">${createRows(
        visibleItems
      )}</div>`;

      if (moreThanFive) {
        html += `
          <button type="button" class="btn btn-link btn-sm px-0 mt-2 tm-bar-chart-toggle">
            ${i18n.showMore}
          </button>
        `;
      }

      container.innerHTML = html;

      function animateBarsWhenVisible(targetEl) {
        if (!targetEl) return;
        const fills = targetEl.querySelectorAll('.tm-bar-row-fill');
        if (!fills.length) return;

        const reduceMotion = window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        fills.forEach(fill => {
          const target = fill.style.width;
          fill.style.width = reduceMotion ? target : '0%';
          fill.setAttribute('data-target-width', target);
        });

        const run = () => {
          fills.forEach((fill, idx) => {
            const target = fill.getAttribute('data-target-width') || '0%';
            if (reduceMotion) {
              fill.style.width = target;
              return;
            }
            setTimeout(() => {
              fill.style.width = target;
            }, idx * 70);
          });
        };

        if (reduceMotion) {
          run();
          return;
        }

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            entries => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  run();
                  observer.disconnect();
                }
              });
            },
            { threshold: 0.25 }
          );
          observer.observe(targetEl);
        } else {
          requestAnimationFrame(run);
        }
      }

      animateBarsWhenVisible(container);

      if (moreThanFive) {
        const bodyEl = container.querySelector('.tm-bar-chart-body');
        const toggleBtn = container.querySelector('.tm-bar-chart-toggle');
        if (toggleBtn && bodyEl) {
          toggleBtn.addEventListener('click', () => {
            const expanded = bodyEl.getAttribute('data-expanded') === 'true';
            if (expanded) {
              bodyEl.innerHTML = createRows(visibleItems);
              animateBarsWhenVisible(bodyEl);
              bodyEl.setAttribute('data-expanded', 'false');
              toggleBtn.textContent = i18n.showMore;
            } else {
              bodyEl.innerHTML = createRows(items);
              animateBarsWhenVisible(bodyEl);
              bodyEl.setAttribute('data-expanded', 'true');
              toggleBtn.textContent = i18n.showLess;
            }
          });
        }
      }
    }

    const openByUser = aggregateBy(tasks, 'assigned_username', t => isOpen(t));
    const completedByUser = aggregateBy(tasks, 'assigned_username', t => isDone(t));
    const overdueByUser = aggregateBy(tasks, 'assigned_username', t => isOverdue(t));
    const overdueBySubject = aggregateBy(tasks, 'konu_sorumlusu_username', t => isOverdue(t));
    const allByDepartment = aggregateBy(tasks, 'departman', () => true);
    const dueSoonByUser = aggregateBy(tasks, 'assigned_username', t => isDueSoon(t, 3));
    const overdueUrgentByUser = aggregateBy(tasks, 'assigned_username', t => isOverdue(t) && isUrgent(t));

    // Pasta grafiği için durumlara göre say
    const statusCounts = tasks.reduce(
      (acc, t) => {
        if (t.status === 'pending') acc.pending += 1;
        if (t.status === 'in_progress') acc.in_progress += 1;
        if (!isOverdueMode && t.status === 'done') acc.done += 1;
        return acc;
      },
      { pending: 0, in_progress: 0, done: 0 }
    );

    function renderStatusPie() {
      const wrap = document.getElementById('chart-overdue-by-status-pie');
      if (!wrap) return;

      const total = isOverdueMode
        ? statusCounts.pending + statusCounts.in_progress
        : statusCounts.pending + statusCounts.in_progress + statusCounts.done;
      const ringEl = wrap.querySelector('.tm-pie-modern-ring');
      const centerValEl = wrap.querySelector('.tm-pie-modern-total');
      const pendingEl = wrap.querySelector(
        '.tm-pie-legend-value[data-status="pending"]'
      );
      const inProgEl = wrap.querySelector(
        '.tm-pie-legend-value[data-status="in_progress"]'
      );
      const pendingPercentEl = wrap.querySelector(
        '.tm-pie-legend-percent[data-status-percent="pending"]'
      );
      const inProgPercentEl = wrap.querySelector(
        '.tm-pie-legend-percent[data-status-percent="in_progress"]'
      );
      const doneEl = wrap.querySelector(
        '.tm-pie-legend-value[data-status="done"]'
      );
      const donePercentEl = wrap.querySelector(
        '.tm-pie-legend-percent[data-status-percent="done"]'
      );

      if (centerValEl) centerValEl.textContent = String(total);
      if (pendingEl) pendingEl.textContent = String(statusCounts.pending);
      if (inProgEl) inProgEl.textContent = String(statusCounts.in_progress);
      if (doneEl) doneEl.textContent = String(statusCounts.done);
      const pendingPct = total ? Math.round((statusCounts.pending / total) * 100) : 0;
      const inProgPct = total ? Math.round((statusCounts.in_progress / total) * 100) : 0;
      const donePct = total ? Math.round((statusCounts.done / total) * 100) : 0;
      if (pendingPercentEl) pendingPercentEl.textContent = `%${pendingPct}`;
      if (inProgPercentEl) inProgPercentEl.textContent = `%${inProgPct}`;
      if (donePercentEl) donePercentEl.textContent = `%${donePct}`;

      if (!ringEl) return;
      if (!total) {
        ringEl.style.background =
          'conic-gradient(#e5e7eb 0deg 360deg)';
        return;
      }

      const pendingDeg = (statusCounts.pending / total) * 360;
      const inProgDeg = (statusCounts.in_progress / total) * 360;
      if (isOverdueMode) {
        animateConicGradient(
          ringEl,
          [
            { color: '#facc15', angle: pendingDeg },
            { color: '#3b82f6', angle: 360 - pendingDeg }
          ],
          900
        );
      } else {
        const doneDeg = 360 - pendingDeg - inProgDeg;
        animateConicGradient(
          ringEl,
          [
            { color: '#facc15', angle: pendingDeg },
            { color: '#3b82f6', angle: inProgDeg },
            { color: '#22c55e', angle: doneDeg }
          ],
          900
        );
      }
    }

    function renderDepartmentPie(items) {
      const wrap = document.getElementById('chart-overdue-by-department-pie');
      if (!wrap) return;

      const ringEl = wrap.querySelector('.tm-pie-modern-ring');
      const totalEl = wrap.querySelector('.tm-pie-modern-total');
      const legendEl = wrap.querySelector('[data-department-legend]');
      if (!ringEl || !totalEl || !legendEl) return;

      const palette = [
        '#3b82f6',
        '#22c55e',
        '#f59e0b',
        '#ef4444',
        '#a855f7',
        '#14b8a6',
        '#f97316'
      ];

      // Çok fazla departman varsa ilk 6 + Diğer yap
      const normalized = (items || []).slice().sort((a, b) => b.value - a.value);
      const top = normalized.slice(0, 6);
      const rest = normalized.slice(6);
      if (rest.length) {
        const restTotal = rest.reduce((sum, it) => sum + it.value, 0);
        top.push({ label: i18n.other, value: restTotal });
      }

      const total = top.reduce((sum, it) => sum + it.value, 0);
      totalEl.textContent = String(total);

      if (!total) {
        ringEl.style.background = 'conic-gradient(#e5e7eb 0deg 360deg)';
        legendEl.innerHTML = `
          <div class="tm-pie-legend-item">
            <span class="tm-pie-legend-color" style="background:#e5e7eb"></span>
            <span class="tm-pie-legend-label">${i18n.noData}</span>
            <span class="tm-pie-legend-percent">%0</span>
            <span class="tm-pie-legend-value">0</span>
          </div>
        `;
        return;
      }

      let angleStart = 0;
      const gradientParts = [];
      const legendRows = [];
      const segments = [];

      top.forEach((it, idx) => {
        const color = palette[idx % palette.length];
        const percent = Math.round((it.value / total) * 100);
        const angle = (it.value / total) * 360;
        const angleEnd = angleStart + angle;

        gradientParts.push(`${color} ${angleStart}deg ${angleEnd}deg`);
        segments.push({ color, angle });
        legendRows.push(`
          <div class="tm-pie-legend-item">
            <span class="tm-pie-legend-color" style="background:${color}"></span>
            <span class="tm-pie-legend-label">${it.label || i18n.other}</span>
            <span class="tm-pie-legend-percent">%${percent}</span>
            <span class="tm-pie-legend-value">${it.value}</span>
          </div>
        `);

        angleStart = angleEnd;
      });

      ringEl.style.background = `conic-gradient(${gradientParts.join(', ')})`;
      animateConicGradient(ringEl, segments, 1000);
      legendEl.innerHTML = legendRows.join('');
    }

    function renderTrendChart() {
      const container = document.getElementById('chart-created-completed-trend');
      if (!container) return;

      const now = new Date();
      const months = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const label = d.toLocaleDateString(undefined, { month: 'short', year: '2-digit' });
        months.push({ key, label, created: 0, completed: 0 });
      }

      const monthMap = new Map(months.map(m => [m.key, m]));
      const toKey = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;

      tasks.forEach(t => {
        const createdAt = parseDate(t.created_at);
        const completedAt = parseDate(t.completed_at);
        if (createdAt) {
          const target = monthMap.get(toKey(createdAt));
          if (target) target.created += 1;
        }
        if (completedAt) {
          const target = monthMap.get(toKey(completedAt));
          if (target) target.completed += 1;
        }
      });

      const maxVal = Math.max(
        1,
        ...months.map(m => Math.max(m.created, m.completed))
      );

      container.innerHTML = `
        <div class="tm-trend-grid">
          ${months.map(m => {
            const createdPct = (m.created / maxVal) * 100;
            const completedPct = (m.completed / maxVal) * 100;
            return `
              <div class="tm-trend-col">
                <div class="tm-trend-bars">
                  <div class="tm-trend-bar tm-trend-bar--created" style="height:${createdPct}%;" title="${i18n.monthCreated}: ${m.created}"></div>
                  <div class="tm-trend-bar tm-trend-bar--completed" style="height:${completedPct}%;" title="${i18n.monthCompleted}: ${m.completed}"></div>
                </div>
                <div class="tm-trend-label">${m.label}</div>
              </div>
            `;
          }).join('')}
        </div>
        <div class="tm-trend-legend">
          <span><i class="bi bi-square-fill text-primary"></i> ${i18n.monthCreated}</span>
          <span><i class="bi bi-square-fill text-success"></i> ${i18n.monthCompleted}</span>
        </div>
      `;
    }

    function renderTopPerformers() {
      const container = document.getElementById('top-performers-board');
      if (!container) return;

      const byUser = new Map();
      tasks.forEach(t => {
        const user = safeLabel(t.assigned_username);
        if (!byUser.has(user)) {
          byUser.set(user, {
            user,
            total: 0,
            completed: 0,
            open: 0,
            overdue: 0,
            onTimeCompleted: 0
          });
        }
        const stat = byUser.get(user);
        stat.total += 1;
        if (isDone(t)) {
          stat.completed += 1;
          const deadline = parseDate(t.deadline);
          const completedAt = parseDate(t.completed_at);
          if (deadline && completedAt && completedAt.getTime() <= deadline.getTime()) {
            stat.onTimeCompleted += 1;
          }
        } else {
          stat.open += 1;
          if (isOverdue(t)) stat.overdue += 1;
        }
      });

      const ranked = Array.from(byUser.values())
        // Top 3 değerlendirmesine sadece belirli hacmin üstündeki kullanıcıları al
        .filter(s => s.total > 10 || s.completed > 10)
        .map(s => {
          const completionRate = s.total ? Math.round((s.completed / s.total) * 100) : 0;
          const onTimeRate = s.completed ? Math.round((s.onTimeCompleted / s.completed) * 100) : 0;
          const overdueRate = s.open ? Math.round((s.overdue / s.open) * 100) : 0;
          const score = Math.round((completionRate * 0.55) + (onTimeRate * 0.25) + ((100 - overdueRate) * 0.20));
          return { ...s, completionRate, onTimeRate, overdueRate, score };
        })
        .sort((a, b) => b.score - a.score || b.completed - a.completed || a.overdue - b.overdue)
        .slice(0, 3);

      if (!ranked.length) {
        container.innerHTML = `<p class="small text-muted mb-0">${i18n.noData}</p>`;
        return;
      }

      const medals = ['🥇', '🥈', '🥉'];
      container.innerHTML = `
        <div class="tm-top3-grid">
          ${ranked.map((r, idx) => `
            <div class="tm-top3-card">
              <div class="tm-top3-head">
                <span class="tm-top3-medal">${medals[idx] || '#' + (idx + 1)}</span>
                <div class="tm-top3-user-wrap">
                  <div class="tm-top3-user">${escapeHtml(r.user)}</div>
                  <div class="tm-top3-score">${i18n.performanceScore}: ${r.score}</div>
                </div>
              </div>
              <div class="tm-top3-stats">
                <span class="tm-top3-stat">${i18n.totalAssigned}: <b>${r.total}</b></span>
                <span class="tm-top3-stat">${i18n.completionRate}: <b>%${r.completionRate}</b></span>
                <span class="tm-top3-stat">${i18n.onTimeRate}: <b>%${r.onTimeRate}</b></span>
                <span class="tm-top3-stat">${i18n.overdueRate}: <b>%${r.overdueRate}</b></span>
              </div>
              <div class="tm-top3-bars">
                <div class="tm-top3-bar-row">
                  <span>${i18n.completionRate}</span>
                  <div class="tm-top3-track"><div class="tm-top3-fill tm-top3-fill--completion" style="width:${r.completionRate}%"></div></div>
                </div>
                <div class="tm-top3-bar-row">
                  <span>${i18n.onTimeRate}</span>
                  <div class="tm-top3-track"><div class="tm-top3-fill tm-top3-fill--ontime" style="width:${r.onTimeRate}%"></div></div>
                </div>
                <div class="tm-top3-bar-row">
                  <span>${i18n.overdueRate}</span>
                  <div class="tm-top3-track"><div class="tm-top3-fill tm-top3-fill--overdue" style="width:${r.overdueRate}%"></div></div>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    function renderOverdueTopicDays() {
      const container = document.getElementById('overdue-topic-days-list');
      if (!container) return;

      const rows = tasks
        .map(t => {
          if (!t || t.status === 'done') return null;
          const overdueDays = getOverdueDays(t);
          if (overdueDays <= 0) return null;

          return {
            id: t.id,
            title: (t.title || i18n.untitledTask).trim(),
            konuSorumlusu: (t.konu_sorumlusu_username || t.assigned_username || '-').trim(),
            status: t.status,
            statusText:
              t.status === 'in_progress'
                ? i18n.statusInProgress
                : t.status === 'pending'
                ? i18n.statusPending
                : String(t.status || ''),
            overdueDays
          };
        })
        .filter(Boolean)
        .sort((a, b) => b.overdueDays - a.overdueDays);

      if (!rows.length) {
        container.innerHTML =
          `<p class="small text-muted mb-0">${i18n.noOverdueTopicFound}</p>`;
        return;
      }

      const topRows = rows.slice(0, 20);
      if (isOverdueMode) {
        container.innerHTML = topRows
          .map(row => {
            return `
              <div class="d-flex align-items-center justify-content-between gap-2 border rounded-3 px-2 py-2 bg-light mb-2">
                <div class="d-flex flex-column" style="min-width: 0;">
                  <a
                    href="/admin/tasks/${row.id}"
                    class="small fw-semibold text-truncate text-decoration-none text-dark"
                    style="min-width: 0;"
                    title="${escapeHtml(row.title)}"
                  >
                    ${escapeHtml(row.title)}
                  </a>
                  <div class="small text-muted d-flex flex-wrap gap-2 align-items-center" style="min-width: 0;">
                    <span class="text-truncate" style="min-width: 0;" title="${escapeHtml(i18n.subjectOwnerLabel)}: ${escapeHtml(row.konuSorumlusu)}">
                      ${escapeHtml(i18n.subjectOwnerLabel)}: ${escapeHtml(row.konuSorumlusu)}
                    </span>
                    <span class="text-truncate" style="min-width: 0;" title="${escapeHtml(i18n.statusLabel)}: ${escapeHtml(row.statusText)}">
                      ${escapeHtml(i18n.statusLabel)}:
                      <span class="badge status-${escapeHtml(row.status)}">${escapeHtml(row.statusText)}</span>
                    </span>
                  </div>
                </div>
                <span class="badge text-bg-danger flex-shrink-0">${row.overdueDays} ${escapeHtml(i18n.daysOverdueSuffix)}</span>
              </div>
            `;
          })
          .join('');
        return;
      }

      const totalOverdue = rows.length;
      const maxOverdue = rows[0] ? rows[0].overdueDays : 0;
      const avgOverdue = totalOverdue
        ? Math.round(rows.reduce((sum, r) => sum + r.overdueDays, 0) / totalOverdue)
        : 0;

      container.innerHTML = `
        <div class="tm-overdue-pro-summary">
          <div class="tm-overdue-pro-stat">
            <span class="tm-overdue-pro-stat-label">Toplam geciken</span>
            <span class="tm-overdue-pro-stat-value">${totalOverdue}</span>
          </div>
          <div class="tm-overdue-pro-stat">
            <span class="tm-overdue-pro-stat-label">Ortalama gecikme</span>
            <span class="tm-overdue-pro-stat-value">${avgOverdue} gün</span>
          </div>
          <div class="tm-overdue-pro-stat">
            <span class="tm-overdue-pro-stat-label">Maksimum gecikme</span>
            <span class="tm-overdue-pro-stat-value">${maxOverdue} gün</span>
          </div>
        </div>
        <div class="tm-overdue-pro-list">
          ${topRows.map((row, idx) => {
            const width = maxOverdue > 0 ? Math.max(8, Math.round((row.overdueDays / maxOverdue) * 100)) : 8;
            return `
              <div class="tm-overdue-pro-row">
                <div class="tm-overdue-pro-rank">#${idx + 1}</div>
                <div class="tm-overdue-pro-main">
                  <a
                    href="/admin/tasks/${row.id}"
                    class="tm-overdue-pro-title"
                    title="${escapeHtml(row.title)}"
                  >
                    ${escapeHtml(row.title)}
                  </a>
                  <div class="tm-overdue-pro-meta">
                    <span class="tm-overdue-pro-chip">
                      <i class="bi bi-person-badge"></i>
                      ${escapeHtml(i18n.subjectOwnerLabel)}: ${escapeHtml(row.konuSorumlusu)}
                    </span>
                    <span class="tm-overdue-pro-chip">
                      <i class="bi bi-flag"></i>
                      ${escapeHtml(i18n.statusLabel)}:
                      <span class="badge status-${escapeHtml(row.status)}">${escapeHtml(row.statusText)}</span>
                    </span>
                  </div>
                </div>
                <div class="tm-overdue-pro-right">
                  <span class="tm-overdue-pro-days">${row.overdueDays} ${escapeHtml(i18n.daysOverdueSuffix)}</span>
                  <div class="tm-overdue-pro-track">
                    <div class="tm-overdue-pro-fill" style="width:${width}%"></div>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    if (!isOverdueMode) {
      renderKpis();
    }
    renderBarChart('chart-open-by-user', openByUser, { variant: 'open' });
    renderBarChart('chart-completed-by-user', completedByUser, { variant: 'completed' });
    renderBarChart('chart-overdue-by-user', overdueByUser, { variant: 'overdue' });
    renderBarChart('chart-overdue-by-subject', overdueBySubject, { variant: 'overdue' });
    renderDepartmentPie(allByDepartment);
    renderBarChart('chart-overdue-urgent-by-user', overdueUrgentByUser, { variant: 'urgent' });
    renderBarChart('chart-due-soon-by-user', dueSoonByUser, { variant: 'soon' });
    renderStatusPie();
    if (!isOverdueMode) {
      renderTrendChart();
      renderTopPerformers();
    }
    renderOverdueTopicDays();
  })();
</script>

