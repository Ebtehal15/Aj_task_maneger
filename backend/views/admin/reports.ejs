        <% } else { %>
          <p class="text-muted mb-0 small"><%= t('noTasks') %></p>
        <% } %>
      </div>
    </div>
    <button type="submit" class="btn btn-warning btn-sm text-dark fw-semibold px-3" style="border-radius: 999px;">
      <i class="bi bi-arrow-right-circle me-1"></i><%= t('showSelectedUsers') %>
    </button>
  </form>

  <% if (typeof selectedUserIds !== 'undefined' && selectedUserIds.length && typeof users !== 'undefined' && users.length) { %>
  <p class="text-muted mb-2"><%= t('selectUserForReport') %></p>

  <% 
    const baseParams = [];
    baseParams.push('tab=users');
    if (typeof selectedUserIdsParam !== 'undefined' && selectedUserIdsParam) {
      baseParams.push('userIds=' + encodeURIComponent(selectedUserIdsParam));
    }
    if (filters && filters.userId) {
      baseParams.push('userId=' + encodeURIComponent(String(filters.userId)));
    }
    const baseQS = baseParams.join('&');
    const currentStatus = (filters && filters.status) ? String(filters.status) : '';
    const isStatusDone = currentStatus === 'done';
    const isStatusInProgress = currentStatus === 'in_progress';
    const isStatusPending = currentStatus === 'pending';
    const isUrgent = !!(filters && (filters.urgent === 'true' || filters.urgent === true));
    const statusBaseQS = baseQS + (isUrgent ? '&urgent=true' : '');
    const urgentBaseQS = baseQS + (currentStatus ? '&status=' + encodeURIComponent(currentStatus) : '');
  %>

  <div class="btn-group btn-group-sm mb-3" role="group" aria-label="User status filters">
    <a
      href="/admin/reports?<%= statusBaseQS %><%= isStatusDone ? '' : (statusBaseQS ? '&' : '') + 'status=done' %>"
      class="btn <%= isStatusDone ? 'btn-success' : 'btn-outline-success' %>"
    >
      <%= t('completedTasks') %>
    </a>
    <a
      href="/admin/reports?<%= statusBaseQS %><%= isStatusInProgress ? '' : (statusBaseQS ? '&' : '') + 'status=in_progress' %>"
      class="btn <%= isStatusInProgress ? 'btn-warning text-dark' : 'btn-outline-warning' %>"
    >
      <%= t('inProgressTasks') %>
    </a>
    <a
